# Supabase project settings -> Dashboard > Project Settings > API
# Copy this file to `.env` and fill in the real values.
#
# `VITE_SUPABASE_ANON_KEY` is the one actually read by
# src/integrations/supabase/client.ts. `VITE_SUPABASE_PUBLISHABLE_KEY` is the
# newer name for the same credential and is kept in sync in existing .env files.
#
# NOTE: the anon/publishable key is designed to be public (it is shipped in the
# client bundle and RLS is the real access control). Row Level Security must stay
# enabled on every table. The service_role key must NEVER be placed here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
