# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=

# Client-side (public / publishable) keys.
# These are safe to expose to the browser and are protected by Row Level Security.
# NEVER add a service_role / secret key here - it is not needed by the client.
# See .gitignore for why .env is excluded from version control.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
